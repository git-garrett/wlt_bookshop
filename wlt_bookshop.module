<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeInterface;
use Drupal\Component\Utility\Html;

if (!defined('WLT_BOOKSHOP_DEFAULT_AFFILIATE_ID')) {
  define('WLT_BOOKSHOP_DEFAULT_AFFILIATE_ID', '81678');
}
if (!defined('WLT_BOOKSHOP_NO_ISBN_SENTINEL')) {
  define('WLT_BOOKSHOP_NO_ISBN_SENTINEL', '0000');
}
if (!defined('WLT_BOOKSHOP_DISABLE_PRESAVE_LOOKUP')) {
  define('WLT_BOOKSHOP_DISABLE_PRESAVE_LOOKUP', TRUE);
}

/**
 * Implements hook_help().
 */
function wlt_bookshop_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.wlt_bookshop':
      return t('WLT Bookshop provides an ISBN lookup service using the Open Library API. Use the service "wlt_bookshop.book_isbn_lookup", the helper function wlt_bookshop_get_isbn_from_node(), or the admin form at /admin/content/wlt-bookshop/isbn-process to manually process configured bundles. The lookup now uses the node\'s configured author field rather than the sidebar title.');
  }
  return NULL;
}

/**
 * Populate ISBNs for enabled bundles using author data.
 */
function wlt_bookshop_entity_presave(EntityInterface $entity): void {
  if (defined('WLT_BOOKSHOP_DISABLE_PRESAVE_LOOKUP') && WLT_BOOKSHOP_DISABLE_PRESAVE_LOOKUP) {
    return;
  }
  if ($entity->getEntityTypeId() !== 'node') {
    return;
  }
  if (!$entity instanceof NodeInterface) {
    return;
  }

  $bundle = $entity->bundle();
  if (!wlt_bookshop_bundle_is_enabled($bundle)) {
    return;
  }

  $author_field = wlt_bookshop_get_bundle_field($bundle, 'author_field') ?? 'field_author';
  $isbn_field = wlt_bookshop_get_bundle_field($bundle, 'isbn_field') ?? 'field_isbn';

  if (wlt_bookshop_is_kill_switch_enabled($entity)) {
    return;
  }
  if (!$entity->hasField($author_field) || !$entity->hasField($isbn_field)) {
    return;
  }

  // Skip lookup when values already exist.
  $existing_values = array_filter(array_map(static function (array $item) {
    return isset($item['value']) ? trim((string) $item['value']) : '';
  }, $entity->get($isbn_field)->getValue()));
  if (!empty($existing_values)) {
    return;
  }

  $title_authors = wlt_bookshop_extract_title_authors($entity);
  $authors = wlt_bookshop_collect_author_names($entity);
  $translators = wlt_bookshop_collect_translator_names($entity);
  if (empty($title_authors) && empty($authors) && empty($translators)) {
    return;
  }

  /** @var \Drupal\wlt_bookshop\Service\BookIsbnLookup $lookup */
  $lookup = \Drupal::service('wlt_bookshop.book_isbn_lookup');
  $limit = 12;
  $collected = [];
  $sequence = 0;

  $debugPlaceholder = NULL;
  $addedFromTitle = FALSE;
  if (!empty($title_authors)) {
    $addedFromTitle = wlt_bookshop_collect_isbns_for_names($lookup, $title_authors, $collected, $limit, 'title_author', $debugPlaceholder, $sequence);
  }
  if (!$addedFromTitle && !empty($authors)) {
    wlt_bookshop_collect_isbns_for_names($lookup, $authors, $collected, $limit, 'author', $debugPlaceholder, $sequence);
  }
  if (!empty($translators) && count($collected) < $limit) {
    wlt_bookshop_collect_isbns_for_names($lookup, $translators, $collected, $limit, 'translator', $debugPlaceholder, $sequence);
  }

  if (empty($collected)) {
    wlt_bookshop_collect_title_fallback_isbns($lookup, $entity, $collected, $debugPlaceholder, $sequence);
  }
  if (empty($collected)) {
    wlt_bookshop_store_no_isbn($entity, $isbn_field);
    return;
  }

  $orderedIsbns = wlt_bookshop_rank_isbn_entries($entity, $collected);
  if (empty($orderedIsbns)) {
    wlt_bookshop_store_no_isbn($entity, $isbn_field);
    return;
  }
  $orderedIsbns = array_slice($orderedIsbns, 0, $limit);

  $items = [];
  foreach ($orderedIsbns as $value) {
    $items[] = ['value' => $value];
  }
  $entity->set($isbn_field, $items);
}

/**
 * Convenience helper: get ISBN from a configured author field.
 *
 * @param \Drupal\node\NodeInterface $node
 *   A loaded node entity.
 *
 * @return string|null
 *   The first ISBN found, or NULL if not available.
 */
function wlt_bookshop_get_isbn_from_node(NodeInterface $node): ?string {
  $bundle = $node->bundle();
  if (!wlt_bookshop_bundle_is_enabled($bundle)) {
    return NULL;
  }
  $title_authors = wlt_bookshop_extract_title_authors($node);
  $authors = wlt_bookshop_collect_author_names($node);
  $translators = wlt_bookshop_collect_translator_names($node);
  if (empty($title_authors) && empty($authors) && empty($translators)) {
    return NULL;
  }

  /** @var \Drupal\wlt_bookshop\Service\BookIsbnLookup $lookup */
  $lookup = \Drupal::service('wlt_bookshop.book_isbn_lookup');
  $collected = [];
  $sequence = 0;
  $debugPlaceholder = NULL;
  $addedFromTitle = FALSE;
  if (!empty($title_authors)) {
    $addedFromTitle = wlt_bookshop_collect_isbns_for_names($lookup, $title_authors, $collected, 12, 'title_author', $debugPlaceholder, $sequence);
  }
  if (!$addedFromTitle && !empty($authors)) {
    wlt_bookshop_collect_isbns_for_names($lookup, $authors, $collected, 12, 'author', $debugPlaceholder, $sequence);
  }
  if (!empty($translators) && count($collected) < 12) {
    wlt_bookshop_collect_isbns_for_names($lookup, $translators, $collected, 12, 'translator', $debugPlaceholder, $sequence);
  }

  if (empty($collected)) {
    return NULL;
  }
  $ordered = wlt_bookshop_rank_isbn_entries($node, $collected);
  return $ordered[0] ?? NULL;
}

/**
 * Collect distinct contributor names from a configurable field.
 *
 * @param \Drupal\node\NodeInterface $node
 *   Node to inspect.
 * @param string|null $field
 *   Field machine name when available.
 *
 * @return string[]
 *   Unique sanitized strings derived from the field.
 */
function wlt_bookshop_collect_names_from_field(NodeInterface $node, ?string $field): array {
  if (!$field || !$node->hasField($field) || $node->get($field)->isEmpty()) {
    return [];
  }
  $names = [];
  foreach ($node->get($field) as $item) {
    if (isset($item->entity) && $item->entity) {
      $label = wlt_bookshop_sanitize_text((string) $item->entity->label());
      if ($label !== '') {
        $names[$label] = TRUE;
        continue;
      }
    }
    if (isset($item->value)) {
      $value = wlt_bookshop_sanitize_text((string) $item->value);
      if ($value !== '') {
        $names[$value] = TRUE;
      }
    }
  }
  return array_keys($names);
}

/**
 * Collect distinct author names from a configured author field.
 *
 * @param \Drupal\node\NodeInterface $node
 *   A loaded node entity.
 *
 * @return string[]
 *   Array of unique author strings.
 */
function wlt_bookshop_collect_author_names(NodeInterface $node): array {
  $field = wlt_bookshop_get_bundle_field($node->bundle(), 'author_field') ?? 'field_author';
  return wlt_bookshop_collect_names_from_field($node, $field);
}

/**
 * Collect distinct translator names from the configured translator field.
 *
 * @param \Drupal\node\NodeInterface $node
 *   A loaded node entity.
 *
 * @return string[]
 *   Array of unique translator strings.
 */
function wlt_bookshop_collect_translator_names(NodeInterface $node): array {
  $field = wlt_bookshop_get_bundle_field($node->bundle(), 'translator_field');
  return wlt_bookshop_collect_names_from_field($node, $field);
}

/**
 * Return sanitized text from the configured title field when available.
 */
function wlt_bookshop_get_configured_title_text(NodeInterface $node): string {
  $field = wlt_bookshop_get_bundle_field($node->bundle(), 'title_field');
  if (!$field || !$node->hasField($field) || $node->get($field)->isEmpty()) {
    return '';
  }
  foreach ($node->get($field) as $item) {
    $value = NULL;
    if (isset($item->value)) {
      $value = $item->value;
    }
    elseif (is_array($item->getValue()) && isset($item->getValue()['value'])) {
      $value = $item->getValue()['value'];
    }
    if ($value !== NULL) {
      $text = wlt_bookshop_sanitize_text((string) $value);
      if ($text !== '') {
        return $text;
      }
    }
  }
  return '';
}

/**
 * Extract trailing "by …" authors from the configured title text.
 */
function wlt_bookshop_extract_title_authors(NodeInterface $node): array {
  $text = wlt_bookshop_get_configured_title_text($node);
  if ($text === '') {
    return [];
  }
  $lower = mb_strtolower($text, 'UTF-8');
  $patterns = [
    ' by ' => ' by ',
    ' with ' => ' with ',
    ' - ' => ' - ',
  ];
  $match = [
    'pos' => FALSE,
    'pattern' => '',
  ];
  foreach ($patterns as $key => $pattern) {
    $found = mb_strripos($lower, $pattern);
    if ($found !== FALSE && ($match['pos'] === FALSE || $found > $match['pos'])) {
      $match = [
        'pos' => $found,
        'pattern' => $pattern,
      ];
    }
  }
  $raw = '';
  if ($match['pos'] !== FALSE) {
    $raw = mb_substr($text, $match['pos'] + mb_strlen($match['pattern'], 'UTF-8'), NULL, 'UTF-8');
  }
  else {
    if (preg_match('/"[^"]+"\s+(.+)$/u', $text, $matches)) {
      $raw = $matches[1] ?? '';
    }
    else {
      return [];
    }
  }
  $raw = trim($raw);
  if ($raw === '') {
    return [];
  }
  $raw = trim($raw, " \t\n\r\0\x0B,.;:!?'\"()[]{}-–—");
  if ($raw === '') {
    return [];
  }
  $parts = preg_split('/\s+(?:&|and)\s+/iu', $raw);
  $names = [];
  foreach ((array) $parts as $part) {
    $clean = wlt_bookshop_sanitize_text((string) $part);
    $clean = trim($clean, " \t\n\r\0\x0B,.;:!?'\"");
    if ($clean !== '') {
      $names[$clean] = TRUE;
    }
  }
  return array_keys($names);
}

/**
 * Append ISBN metadata discovered for the provided contributor names.
 */
function wlt_bookshop_collect_isbns_for_names(\Drupal\wlt_bookshop\Service\BookIsbnLookup $lookup, array $names, array &$collected, int $limit, string $source, ?array &$debug = NULL, int &$sequence = 0): bool {
  $added = FALSE;
  foreach ($names as $name) {
    $name = trim((string) $name);
    if ($name === '') {
      continue;
    }
    if (method_exists($lookup, 'getIsbnEntriesByAuthor')) {
      $entries = $debug !== NULL
        ? $lookup->getIsbnEntriesByAuthor($name, $debug)
        : $lookup->getIsbnEntriesByAuthor($name);
    }
    elseif (method_exists($lookup, 'getIsbnsByAuthor')) {
      $list = $debug !== NULL
        ? $lookup->getIsbnsByAuthor($name, $debug)
        : $lookup->getIsbnsByAuthor($name);
      $entries = array_map(static fn($isbn) => ['isbn' => $isbn], (array) $list);
    }
    elseif (method_exists($lookup, 'getIsbnByAuthor')) {
      $single = $debug !== NULL
        ? $lookup->getIsbnByAuthor($name, $debug)
        : $lookup->getIsbnByAuthor($name);
      $entries = $single ? [['isbn' => $single]] : [];
    }
    else {
      $entries = [];
    }

    foreach ($entries as $entry) {
      $normalized = wlt_bookshop_normalize_isbn((string) ($entry['isbn'] ?? ''));
      if (!$normalized) {
        continue;
      }
      if (!isset($collected[$normalized])) {
        $collected[$normalized] = [
          'isbn' => $normalized,
          'source' => $source,
          'preferred' => !empty($entry['preferred']),
          'title' => isset($entry['title']) ? (string) $entry['title'] : '',
          'work_title' => isset($entry['work_title']) ? (string) $entry['work_title'] : '',
          'discovery' => $sequence++,
        ];
        $added = TRUE;
        if (count($collected) >= $limit) {
          return TRUE;
        }
      }
    }
  }
  return $added;
}

/**
 * Attempt fallback ISBN collection using title heuristics.
 */
function wlt_bookshop_collect_title_fallback_isbns(\Drupal\wlt_bookshop\Service\BookIsbnLookup $lookup, NodeInterface $node, array &$collected, ?array &$debug = NULL, int &$sequence = 0): bool {
  if (!method_exists($lookup, 'getTitleFallbackEntries')) {
    return FALSE;
  }
  $title = wlt_bookshop_get_configured_title_text($node);
  if ($title === '') {
    $title = wlt_bookshop_sanitize_text((string) $node->label());
  }
  $batches = [];
  $richTitle = wlt_bookshop_extract_rich_title_emphasis($node);
  if ($richTitle !== NULL) {
    $richEntries = $lookup->getTitleFallbackEntries($richTitle, $debug);
    if (!empty($richEntries)) {
      foreach ($richEntries as &$entry) {
        $entry['source'] = $entry['source'] ?? 'title_richtitle';
        $entry['title'] = $entry['title'] ?? $richTitle;
        $entry['work_title'] = $entry['work_title'] ?? $richTitle;
        $entry['fallback_priority'] = isset($entry['fallback_priority'])
          ? min((int) $entry['fallback_priority'], -25)
          : -25;
      }
      unset($entry);
      $batches[] = $richEntries;
    }
  }
  if ($title !== '') {
    $entries = $lookup->getTitleFallbackEntries($title, $debug);
    if (!empty($entries)) {
      $batches[] = $entries;
    }
  }
  if (empty($batches)) {
    return FALSE;
  }
  $added = FALSE;
  foreach ($batches as $entries) {
    foreach ($entries as $entry) {
      $normalized = wlt_bookshop_normalize_isbn((string) ($entry['isbn'] ?? ''));
      if (!$normalized || isset($collected[$normalized])) {
        continue;
      }
      $collected[$normalized] = [
        'isbn' => $normalized,
        'source' => $entry['source'] ?? 'title_fallback',
        'preferred' => !empty($entry['preferred']),
        'title' => $entry['title'] ?? $title,
        'work_title' => $entry['work_title'] ?? $title,
        'discovery' => $sequence++,
        'fallback_priority' => isset($entry['fallback_priority']) ? (int) $entry['fallback_priority'] : -10,
      ];
      $added = TRUE;
    }
  }
  return $added;
}

/**
 * Extract the first emphasized (<em>) string from field_richtitle.
 */
function wlt_bookshop_extract_rich_title_emphasis(NodeInterface $node): ?string {
  if (!$node->hasField('field_richtitle') || $node->get('field_richtitle')->isEmpty()) {
    return NULL;
  }
  foreach ($node->get('field_richtitle') as $item) {
    $raw = '';
    if (isset($item->value)) {
      $raw = (string) $item->value;
    }
    elseif (is_array($item->getValue()) && isset($item->getValue()['value'])) {
      $raw = (string) $item->getValue()['value'];
    }
    if ($raw === '') {
      continue;
    }
    if (preg_match('/<em[^>]*>(.*?)<\/em>/is', $raw, $matches) && isset($matches[1])) {
      $text = strip_tags(html_entity_decode($matches[1], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'));
      $text = wlt_bookshop_sanitize_text($text);
      if ($text !== '') {
        return $text;
      }
    }
  }
  return NULL;
}

/**
 * Extract the rendered body field text for substring comparisons.
 */
function wlt_bookshop_extract_body_text(NodeInterface $node): string {
  if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
    return '';
  }
  $values = [];
  foreach ($node->get('body') as $item) {
    if (isset($item->value)) {
      $values[] = (string) $item->value;
    }
  }
  if (empty($values)) {
    return '';
  }
  $combined = implode("\n", $values);
  $combined = html_entity_decode($combined, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
  return strip_tags($combined);
}

/**
 * Case-insensitive substring helper for normalized text.
 */
function wlt_bookshop_text_contains(string $haystack, string $needle): bool {
  $haystack = mb_strtolower(trim($haystack), 'UTF-8');
  $needle = mb_strtolower(trim($needle), 'UTF-8');
  if ($haystack === '' || $needle === '') {
    return FALSE;
  }
  return mb_strpos($haystack, $needle) !== FALSE;
}

/**
 * Rank ISBN metadata based on title/body matches and cover preference.
 */
function wlt_bookshop_rank_isbn_entries(NodeInterface $node, array $entries): array {
  if (empty($entries)) {
    return [];
  }

  $configuredTitle = mb_strtolower(wlt_bookshop_get_configured_title_text($node));
  $sidebarTitle = '';
  if ($node->hasField('field_sidebartitle') && !$node->get('field_sidebartitle')->isEmpty()) {
    $sidebarTitle = mb_strtolower(wlt_bookshop_sanitize_text((string) $node->get('field_sidebartitle')->value));
  }
  $bodyText = mb_strtolower(wlt_bookshop_sanitize_text(wlt_bookshop_extract_body_text($node)));

  foreach ($entries as &$entry) {
    $candidateTitle = $entry['title'] ?? '';
    if ($candidateTitle === '' && !empty($entry['work_title'])) {
      $candidateTitle = $entry['work_title'];
    }
    $normalizedTitle = mb_strtolower(wlt_bookshop_sanitize_text($candidateTitle));
    $rank = 4;
    if ($normalizedTitle !== '') {
      if ($configuredTitle !== '' && wlt_bookshop_text_contains($configuredTitle, $normalizedTitle)) {
        $rank = min($rank, 0);
      }
      if ($sidebarTitle !== '' && wlt_bookshop_text_contains($sidebarTitle, $normalizedTitle)) {
        $rank = min($rank, 1);
      }
      if ($bodyText !== '' && wlt_bookshop_text_contains($bodyText, $normalizedTitle)) {
        $rank = min($rank, 2);
      }
    }
    if (!empty($entry['preferred'])) {
      $rank = min($rank, 3);
    }
    if (isset($entry['fallback_priority'])) {
      $rank = min($rank, (int) $entry['fallback_priority']);
    }
    if (($entry['source'] ?? '') === 'translator') {
      $rank += 10;
    }
    $entry['rank'] = $rank;
  }
  unset($entry);

  uasort($entries, static function (array $a, array $b): int {
    if (($a['rank'] ?? 0) !== ($b['rank'] ?? 0)) {
      return ($a['rank'] ?? 0) <=> ($b['rank'] ?? 0);
    }
    return ($a['discovery'] ?? 0) <=> ($b['discovery'] ?? 0);
  });

  return array_map(static fn(array $entry) => $entry['isbn'], $entries);
}

/**
 * Normalize author/title text by removing markup and collapsing whitespace.
 */
function wlt_bookshop_sanitize_text(string $text): string {
  if ($text === '') {
    return '';
  }
  $text = html_entity_decode($text, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
  $text = strip_tags($text);
  return trim(preg_replace('/\s+/u', ' ', $text));
}

/**
 * Normalize raw ISBN input to a 13-digit numeric string when possible.
 *
 * @param string $isbn
 *   Raw ISBN/ISBN-13 candidate.
 *
 * @return string|null
 *   Normalized 13-digit string or NULL if normalization failed.
 */
function wlt_bookshop_normalize_isbn(string $isbn): ?string {
  $isbn = strtoupper(trim($isbn));
  if ($isbn === '') {
    return NULL;
  }
  // Allow digits and trailing X for ISBN-10.
  $filtered = preg_replace('/[^0-9X]/', '', $isbn);
  if ($filtered === '') {
    return NULL;
  }
  if (strlen($filtered) === 13 && ctype_digit($filtered)) {
    return $filtered;
  }
  if (strlen($filtered) === 10) {
    $core = substr($filtered, 0, 9);
    if (!ctype_digit($core)) {
      return NULL;
    }
    $ean = '978' . $core;
    $sum = 0;
    for ($i = 0; $i < 12; $i++) {
      $digit = (int) $ean[$i];
      $sum += ($i % 2 === 0) ? $digit : $digit * 3;
    }
    $check = (10 - ($sum % 10)) % 10;
    return $ean . $check;
  }
  // Return 13-digit string if we can infer it, otherwise drop.
  return NULL;
}

/**
 * Retrieve the first author name from the node, if available.
 */
function wlt_bookshop_get_primary_author(NodeInterface $node): ?string {
  $title_authors = wlt_bookshop_extract_title_authors($node);
  if (!empty($title_authors)) {
    $first = reset($title_authors);
    if ($first !== FALSE && $first !== '') {
      return $first;
    }
  }
  $authors = wlt_bookshop_collect_author_names($node);
  if (empty($authors)) {
    return NULL;
  }
  return reset($authors) ?: NULL;
}

/**
 * Retrieve the configured Bookshop affiliate ID.
 */
function wlt_bookshop_get_affiliate_id(): string {
  static $cached;
  if ($cached !== NULL) {
    return $cached;
  }
  $affiliate = '';
  try {
    $config = \Drupal::config('wlt_bookshop.settings');
    if ($config) {
      $affiliate = trim((string) $config->get('affiliate_id'));
    }
  }
  catch (\Throwable $e) {
    $affiliate = '';
  }
  if ($affiliate === '' && defined('WLT_BOOKSHOP_DEFAULT_AFFILIATE_ID')) {
    $affiliate = WLT_BOOKSHOP_DEFAULT_AFFILIATE_ID;
  }
  $cached = $affiliate;
  return $cached;
}

/**
 * Build a Bookshop search URL for a given author.
 */
function wlt_bookshop_author_search_url(string $author): string {
  $author = trim($author);
  if ($author === '') {
    return '';
  }
  $query = [
    'keywords' => $author,
  ];
  $affiliate = wlt_bookshop_get_affiliate_id();
  if ($affiliate !== '') {
    $query['aff'] = $affiliate;
  }
  return 'https://bookshop.org/books?' . http_build_query($query);
}

/**
 * Link the first occurrence of $author inside $html with $url.
 */
function wlt_bookshop_link_author_in_html(string $html, string $author, string $url): string {
  $author = trim($author);
  if ($author === '' || stripos($html, $author) === FALSE || $url === '') {
    return $html;
  }

  $internal = libxml_use_internal_errors(TRUE);
  $wrapped = '<div id="wlt-bookshop-wrapper">' . $html . '</div>';
  $dom = new \DOMDocument('1.0', 'UTF-8');
  $loaded = $dom->loadHTML('<?xml encoding="utf-8" ?>' . $wrapped, LIBXML_HTML_NODEFDTD | LIBXML_HTML_NOIMPLIED);
  if (!$loaded) {
    libxml_clear_errors();
    libxml_use_internal_errors($internal);
    // Fallback simple replacement.
    $pattern = '/' . preg_quote($author, '/') . '/iu';
    $replacement = '<a href="' . Html::escape($url) . '" class="wlt-bookshop-author-link" target="_blank" rel="noopener noreferrer">$0</a>';
    return preg_replace($pattern, $replacement, $html, 1) ?? $html;
  }

  $xpath = new \DOMXPath($dom);
  $textNodes = $xpath->query('//text()');
  $matched = FALSE;
  $needleLength = mb_strlen($author);

  foreach ($textNodes as $textNode) {
    $parent = $textNode->parentNode;
    if (!$parent) {
      continue;
    }
    $parentName = strtolower($parent->nodeName);
    if (in_array($parentName, ['script', 'style', 'a'], TRUE)) {
      continue;
    }
    $text = $textNode->wholeText;
    $position = mb_stripos($text, $author);
    if ($position === FALSE) {
      continue;
    }

    $before = mb_substr($text, 0, $position);
    $match = mb_substr($text, $position, $needleLength);
    $after = mb_substr($text, $position + $needleLength);

    if ($before !== '') {
      $parent->insertBefore($dom->createTextNode($before), $textNode);
    }

    $link = $dom->createElement('a');
    $link->setAttribute('href', $url);
    $link->setAttribute('class', 'wlt-bookshop-author-link');
    $link->setAttribute('target', '_blank');
    $link->setAttribute('rel', 'noopener noreferrer');
    $link->appendChild($dom->createTextNode($match));
    $parent->insertBefore($link, $textNode);

    if ($after !== '') {
      $parent->insertBefore($dom->createTextNode($after), $textNode);
    }

    $parent->removeChild($textNode);
    $matched = TRUE;
    break;
  }

  $output = $html;
  if ($matched) {
    $wrapper = $dom->getElementById('wlt-bookshop-wrapper');
    if ($wrapper) {
      $fragments = '';
      foreach ($wrapper->childNodes as $child) {
        $fragments .= $dom->saveHTML($child);
      }
      if ($fragments !== '') {
        $output = $fragments;
      }
    }
  }

  libxml_clear_errors();
  libxml_use_internal_errors($internal);
  return $output;
}

/**
 * Inject a Bookshop link for the primary author inside the node body.
 */
function wlt_bookshop_node_view(array &$build, NodeInterface $node, EntityViewDisplayInterface $display, $view_mode): void {
  $bundle = $node->bundle();
  if (!wlt_bookshop_bundle_is_enabled($bundle)) {
    return;
  }
  if (wlt_bookshop_is_kill_switch_enabled($node)) {
    return;
  }
  $current_user = \Drupal::currentUser();
  if (!$current_user || !in_array((int) $current_user->id(), [3465, 1234], TRUE)) {
    return;
  }
  if (empty($build['body']) || empty($build['body'][0]) || !$node->hasField('body') || $node->get('body')->isEmpty()) {
    return;
  }

  $targets = [];
  $author = wlt_bookshop_get_primary_author($node);
  if ($author) {
    $targets[$author] = TRUE;
  }
  $editor_field = wlt_bookshop_get_bundle_field($bundle, 'editor_field') ?? 'field_editor';
  if ($editor_field !== '' && $node->hasField($editor_field) && !$node->get($editor_field)->isEmpty()) {
    foreach ($node->get($editor_field) as $item) {
      if (isset($item->entity) && $item->entity) {
        $label = wlt_bookshop_sanitize_text((string) $item->entity->label());
        if ($label !== '') {
          $targets[$label] = TRUE;
        }
        continue;
      }
      if (isset($item->value)) {
        $value = wlt_bookshop_sanitize_text((string) $item->value);
        if ($value !== '') {
          $targets[$value] = TRUE;
        }
      }
    }
  }

  if (empty($targets)) {
    return;
  }

  $body_element =& $build['body'][0];
  $updated = FALSE;

  foreach (array_keys($targets) as $name) {
    $url = wlt_bookshop_author_search_url($name);
    if ($url === '') {
      continue;
    }
    foreach (['#text', '#markup'] as $key) {
      if (isset($body_element[$key]) && is_string($body_element[$key])) {
        $body_element[$key] = wlt_bookshop_link_author_in_html($body_element[$key], $name, $url);
        $updated = TRUE;
        break 2;
      }
    }
  }

  if (!$updated && isset($body_element['#context']['value']) && is_string($body_element['#context']['value'])) {
    foreach (array_keys($targets) as $name) {
      $url = wlt_bookshop_author_search_url($name);
      if ($url === '') {
        continue;
      }
      $linked = wlt_bookshop_link_author_in_html($body_element['#context']['value'], $name, $url);
      if ($linked !== $body_element['#context']['value']) {
        $body_element['#context']['value'] = $linked;
        $updated = TRUE;
        break;
      }
    }
  }

  if ($updated) {
    $body_element['#cache']['tags'][] = 'wlt_bookshop:author-link';
  }
}

/**
 * Retrieve default bundle settings used when configuration is absent.
 */
function wlt_bookshop_default_bundle_settings(): array {
  return [
    'author_field' => 'field_author',
    'isbn_field' => 'field_isbn',
    'editor_field' => 'field_editor',
    'translator_field' => '',
    'title_field' => '',
    'kill_switch_field' => 'field_isbn_kill_switch',
    'bypass_uid_check' => FALSE,
  ];
}

/**
 * Load configured bundle settings with sane fallbacks.
 *
 * @return array<string, array>
 *   Mapping of bundle IDs to settings arrays.
 */
function wlt_bookshop_get_bundle_configuration(): array {
  static $cache;
  if ($cache !== NULL) {
    return $cache;
  }
  $defaults = wlt_bookshop_default_bundle_settings();
  $cache = [];
  try {
    $config = \Drupal::config('wlt_bookshop.settings');
    $stored = $config ? $config->get('bundle_settings') : NULL;
  }
  catch (\Throwable $e) {
    $stored = NULL;
  }

  if ($stored === NULL) {
    $cache = ['book_review' => $defaults];
    return $cache;
  }

  if (!is_array($stored)) {
    $stored = [];
  }

  foreach ($stored as $bundle => $settings) {
    if (!is_string($bundle) || $bundle === '') {
      continue;
    }
    if (!is_array($settings)) {
      $settings = [];
    }
    $computed = $settings + $defaults;
    $computed['bypass_uid_check'] = !empty($computed['bypass_uid_check']);
    $cache[$bundle] = $computed;
  }
  return $cache;
}

/**
 * Determine whether a bundle is configured for Bookshop processing.
 */
function wlt_bookshop_bundle_is_enabled(string $bundle): bool {
  $configuration = wlt_bookshop_get_bundle_configuration();
  return isset($configuration[$bundle]);
}

/**
 * Retrieve bundle settings or defaults for a bundle.
 */
function wlt_bookshop_get_bundle_settings(string $bundle): array {
  $configuration = wlt_bookshop_get_bundle_configuration();
  if (isset($configuration[$bundle])) {
    return $configuration[$bundle];
  }
  return wlt_bookshop_default_bundle_settings();
}

/**
 * Retrieve a specific field machine name for a bundle.
 */
function wlt_bookshop_get_bundle_field(string $bundle, string $key): ?string {
  $settings = wlt_bookshop_get_bundle_settings($bundle);
  if (!isset($settings[$key])) {
    return NULL;
  }
  $value = (string) $settings[$key];
  return $value !== '' ? $value : NULL;
}

/**
 * Check whether the kill switch is enabled on a node via configuration.
 */
function wlt_bookshop_is_kill_switch_enabled(NodeInterface $node): bool {
  $kill_switch_field = wlt_bookshop_get_bundle_field($node->bundle(), 'kill_switch_field');
  if (!$kill_switch_field || !$node->hasField($kill_switch_field) || $node->get($kill_switch_field)->isEmpty()) {
    return FALSE;
  }
  $value = $node->get($kill_switch_field)->value;
  return in_array((string) $value, ['1', 'true', 'on'], TRUE);
}
/**
 * Persist a sentinel value indicating no ISBNs were found.
 */
function wlt_bookshop_store_no_isbn(NodeInterface $node, string $isbn_field): void {
  if (!$node->hasField($isbn_field)) {
    return;
  }
  $existing = $node->get($isbn_field)->getValue();
  if (count($existing) === 1 && isset($existing[0]['value']) && (string) $existing[0]['value'] === WLT_BOOKSHOP_NO_ISBN_SENTINEL) {
    return;
  }
  $node->set($isbn_field, [['value' => WLT_BOOKSHOP_NO_ISBN_SENTINEL]]);
}
