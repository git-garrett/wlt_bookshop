<?php

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function wlt_bookshop_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.wlt_bookshop':
      return t('WLT Bookshop provides an ISBN lookup service using the Open Library API. Use the service "wlt_bookshop.book_isbn_lookup", the helper function wlt_bookshop_get_isbn_from_node(), or the admin form at /admin/content/wlt-bookshop/isbn-process to manually process book review nodes. The lookup now uses the node\'s field_author rather than the sidebar title.');
  }
  return NULL;
}

/**
 * Populate ISBNs for book_review nodes using author data.
 */
function wlt_bookshop_entity_presave(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'node') {
    return;
  }
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'book_review') {
    return;
  }
  if (!$entity->hasField('field_author') || !$entity->hasField('field_isbn')) {
    return;
  }

  // Skip lookup when values already exist.
  $existing_values = array_filter(array_map(static function (array $item) {
    return isset($item['value']) ? trim((string) $item['value']) : '';
  }, $entity->get('field_isbn')->getValue()));
  if (!empty($existing_values)) {
    return;
  }

  $authors = wlt_bookshop_collect_author_names($entity);
  if (empty($authors)) {
    return;
  }

  /** @var \Drupal\wlt_bookshop\Service\BookIsbnLookup $lookup */
  $lookup = \Drupal::service('wlt_bookshop.book_isbn_lookup');
  $collected = [];
  foreach ($authors as $author) {
    $isbns = [];
    if (method_exists($lookup, 'getIsbnsByAuthor')) {
      $isbns = $lookup->getIsbnsByAuthor($author);
    }
    elseif (method_exists($lookup, 'getIsbnByAuthor')) {
      $single = $lookup->getIsbnByAuthor($author);
      $isbns = $single ? [$single] : [];
    }

    foreach ($isbns as $isbn) {
      $sanitized = preg_replace('/\D+/', '', (string) $isbn);
      if ($sanitized === '') {
        continue;
      }
      if (!isset($collected[$sanitized])) {
        $collected[$sanitized] = TRUE;
      }
      if (count($collected) >= 12) {
        break 2;
      }
    }
  }

  if (empty($collected)) {
    return;
  }

  $items = [];
  foreach (array_keys($collected) as $value) {
    $items[] = ['value' => $value];
  }
  $entity->set('field_isbn', $items);
}

/**
 * Convenience helper: get ISBN from a book_review node's field_author.
 *
 * @param \Drupal\node\NodeInterface $node
 *   A loaded node entity.
 *
 * @return string|null
 *   The first ISBN found, or NULL if not available.
 */
function wlt_bookshop_get_isbn_from_node(NodeInterface $node): ?string {
  if ($node->bundle() !== 'book_review') {
    return NULL;
  }
  // Resolve title and first author for a simple single-value helper.
  $title = '';
  if ($node->hasField('field_sidebartitle')) {
    $title = trim((string) $node->get('field_sidebartitle')->value);
  }
  if ($title === '') {
    $title = (string) $node->label();
  }
  $author = NULL;
  if ($node->hasField('field_author') && !$node->get('field_author')->isEmpty()) {
    foreach ($node->get('field_author') as $item) {
      if (isset($item->entity) && $item->entity) {
        $label = trim((string) $item->entity->label());
        if ($label !== '') { $author = $label; break; }
      }
      if (isset($item->value)) {
        $val = trim((string) $item->value);
        if ($val !== '') { $author = $val; break; }
      }
    }
  }
  if ($title === '' && !$author) { return NULL; }

  /** @var \Drupal\wlt_bookshop\Service\BookIsbnLookup $lookup */
  $lookup = \Drupal::service('wlt_bookshop.book_isbn_lookup');
  if (method_exists($lookup, 'getEansByTitleAuthor')) {
    $list = $lookup->getEansByTitleAuthor($title, $author ? [$author] : []);
    return $list[0] ?? NULL;
  }
  return NULL;
}

/**
 * Collect distinct author names from a book_review node.
 *
 * @param \Drupal\node\NodeInterface $node
 *   A loaded node entity.
 *
 * @return string[]
 *   Array of unique author strings.
 */
function wlt_bookshop_collect_author_names(NodeInterface $node): array {
  if (!$node->hasField('field_author') || $node->get('field_author')->isEmpty()) {
    return [];
  }
  $names = [];
  foreach ($node->get('field_author') as $item) {
    if (isset($item->entity) && $item->entity) {
      $label = wlt_bookshop_sanitize_text((string) $item->entity->label());
      if ($label !== '') {
        $names[$label] = TRUE;
        continue;
      }
    }
    if (isset($item->value)) {
      $value = wlt_bookshop_sanitize_text((string) $item->value);
      if ($value !== '') {
        $names[$value] = TRUE;
      }
    }
  }
  return array_keys($names);
}

/**
 * Normalize author/title text by removing markup and collapsing whitespace.
 */
function wlt_bookshop_sanitize_text(string $text): string {
  if ($text === '') {
    return '';
  }
  $text = html_entity_decode($text, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
  $text = strip_tags($text);
  return trim(preg_replace('/\s+/u', ' ', $text));
}
